generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// রোল ভিত্তিক ইউজার ম্যানেজমেন্ট
enum Role {
  MENTOR
  STUDENT
  ADMIN
}

enum Status {
  ACTIVE
  BLOCKED
}

// সাবমিশনের স্ট্যাটাস
enum SubmissionStatus {
  PENDING
  SUBMITTED
  REVIEWED
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String?  @unique
  password  String?
  status    Status   @default(ACTIVE)
  role      Role     @default(STUDENT)
  os        String?
  browser   String?
  device    String?
  isVerify  Boolean  @default(false)
  photo     String? // প্রফাইল ছবি
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments Assignment[]
  submissions Submission[]

  @@index([email, status, role, isDeleted])
  @@map("users")
}

model Assignment {
  id          String   @id @default(uuid())
  batch       String   @db.VarChar(255)
  deadline    DateTime
  description String   @db.VarChar(5000)
  title       String   @db.VarChar(255)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  submissions Submission[]

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, title, isDeleted])
  @@map("assignmentsts")
}

model Submission {
  id           String     @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  description String? @db.VarChar(5000)
  notes       String? @db.VarChar(1000)

  feedback String?          @db.VarChar(2000)
  marks    Int?
  status   SubmissionStatus @default(SUBMITTED)

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, studentId])
  @@index([studentId, assignmentId, isDeleted])
  @@map("submissions")
}
